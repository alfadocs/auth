{
  "name": "@alfadocs/auth",
  "version": "0.5.0",
  "description": "Bridgeable Alfadocs auth core with infrastructure adapters",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./supabase-bridge": {
      "types": "./dist/supabase-bridge/index.d.ts",
      "import": "./dist/supabase-bridge/index.js",
      "default": "./dist/supabase-bridge/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "supabase"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.react.json",
    "local:test-app": "npm run build && node tests/local-app/server.mjs",
    "test": "vitest run",
    "test:deno": "deno test tests/deno/",
    "prepare": "npm run build"
  },
  "keywords": [
    "oauth2",
    "alfadocs",
    "auth",
    "bridge",
    "supabase"
  ],
  "author": "AlfaDocs",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "deno-bin": "^2.2.7",
    "dotenv": "^17.4.1",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.6.3",
    "undici": "^8.0.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "jose": "^6.2.2"
  }
}
